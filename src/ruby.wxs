<?xml version="1.0" encoding="utf-8"?>

<!--
  MSI authoring for the official Ruby mswin binary package.

  All variable inputs are supplied by build.ps1 as preprocessor variables:
    RubyVersion    full version, e.g. 4.1.0 (must be numeric x.y.z for MSI)
    RubySeries     X.Y series, e.g. 4.1
    Arch           x64 | arm64
    Scope          perMachine | perUser
    UpgradeCode    UUIDv5 derived from (series, arch); see docs/upgrade-code.md
    PathComponentGuid UUIDv5 derived from (series, arch, scope)
    EnvSystem      yes (HKLM, perMachine) | no (HKCU, perUser)
    InstallDirName e.g. Ruby-4.1-x64-mswin
    StagingDir     extracted zip contents (bin/, lib/, include/, share/, LICENSES/)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ruby $(var.RubyVersion) ($(var.Arch) mswin)"
           Manufacturer="Ruby Core Team"
           Version="$(var.RubyVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="$(var.Scope)"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Ruby $(var.RubySeries) is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <?if $(var.Scope) = perUser ?>
      <StandardDirectory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="$(var.InstallDirName)" />
        </Directory>
      </StandardDirectory>
    <?else?>
      <StandardDirectory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.InstallDirName)" />
      </StandardDirectory>
    <?endif?>

    <Feature Id="Main" Title="Ruby" Level="1">
      <ComponentGroupRef Id="RubyTree" />
      <ComponentRef Id="PathComponent" />
    </Feature>

    <ComponentGroup Id="RubyTree" Directory="INSTALLFOLDER">
      <Files Include="$(var.StagingDir)\**" />
    </ComponentGroup>

    <Component Id="PathComponent" Directory="INSTALLFOLDER" Guid="$(var.PathComponentGuid)">
      <CreateFolder />
      <Environment Id="UpdatePath" Name="PATH" Value="[INSTALLFOLDER]bin"
                   Part="last" Action="set" System="$(var.EnvSystem)" Permanent="no" />
    </Component>

  </Package>
</Wix>
